     Local mode arrays — must live in this RRO so ListPreference inflate
     resolves entries/entryValues (runtime NotFoundException #0x10030028
     when using @*org.lineageos.lineageparts:array/…).
-->
<resources>
    <string-array name="charging_control_mode_entries" translatable="false">
        <item>@string/charging_control_mode_auto_title</item>
        <item>@string/charging_control_mode_custom_title</item>
    </string-array>

    <string-array name="charging_control_mode_values" translatable="false">
        <item>1</item>
        <item>2</item>
    </string-array>

    <string-array name="charging_speed_entries">
        <item>Default (full speed)</item>
        <item>~15W class</item>
        <item>~18W class</item>
        <item>~27W class</item>
    </string-array>

    <string-array name="charging_speed_values">
        <item>0</item>
        <item>2</item>
        <item>3</item>
        <item>5</item>
    </string-array>
</resources>
