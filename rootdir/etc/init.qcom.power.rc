# Balanced mode
on property:perf_profile=0
    # Scheduler migration thresholds
    write /proc/sys/kernel/sched_upmigrate "95 95"
    write /proc/sys/kernel/sched_downmigrate "85 85"    
    # Restore neutral schedutil/WALT policy
    write /sys/devices/system/cpu/cpu0/cpufreq/schedutil/hispeed_load 90
    write /sys/devices/system/cpu/cpu0/cpufreq/schedutil/hispeed_freq 0
    write /sys/devices/system/cpu/cpu0/cpufreq/schedutil/pl 0
    write /sys/devices/system/cpu/cpu4/cpufreq/schedutil/hispeed_load 90
    write /sys/devices/system/cpu/cpu4/cpufreq/schedutil/hispeed_freq 0
    write /sys/devices/system/cpu/cpu4/cpufreq/schedutil/pl 0
    write /sys/devices/system/cpu/cpu7/cpufreq/schedutil/hispeed_load 90
    write /sys/devices/system/cpu/cpu7/cpufreq/schedutil/hispeed_freq 0
    write /sys/devices/system/cpu/cpu7/cpufreq/schedutil/pl 0
   # Boost set all cores input_boost_freq
    write /sys/module/cpu_boost/parameters/input_boost_freq "0:0"
	write /sys/module/cpu_boost/parameters/input_boost_ms 0
    # Thermals
    write /sys/class/thermal/thermal_zone73/cdev0_upper_limit 12
    write /sys/class/thermal/thermal_zone73/cdev1_upper_limit 15
    write /sys/class/kgsl/kgsl-3d0/throttling 1
    # Props
    setprop vendor.display.enable_rotator_ui 0
    # Top App Stune Boost
    write /dev/stune/foreground/schedtune.boost 0
    write /dev/stune/foreground/schedtune.prefer_idle 1
    write /dev/stune/top-app/schedtune.prefer_idle 1
    # Setup runtime cpusets
    write /dev/cpuset/foreground/cpus 0-2,4-6
    # VM
    write /proc/sys/vm/dirty_expire_centisecs 1000
    write /proc/sys/vm/dirty_writeback_centisecs 3000
    # MISC
    write /sys/module/sync/parameters/fsync_enabled "Y"

# Gaming mode
on property:perf_profile=1
    # Prefer earlier migration toward the performance clusters
    write /proc/sys/kernel/sched_upmigrate "96 88"
    write /proc/sys/kernel/sched_downmigrate "55 66"
    # Set neutral schedutil/WALT policy.
    write /sys/devices/system/cpu/cpu0/cpufreq/schedutil/hispeed_load 85
    write /sys/devices/system/cpu/cpu0/cpufreq/schedutil/hispeed_freq 1209600
    write /sys/devices/system/cpu/cpu0/cpufreq/schedutil/pl 1
    write /sys/devices/system/cpu/cpu4/cpufreq/schedutil/hispeed_load 85
    write /sys/devices/system/cpu/cpu4/cpufreq/schedutil/hispeed_freq 1612800
    write /sys/devices/system/cpu/cpu4/cpufreq/schedutil/pl 1
    write /sys/devices/system/cpu/cpu7/cpufreq/schedutil/hispeed_load 85
    write /sys/devices/system/cpu/cpu7/cpufreq/schedutil/hispeed_freq 1612800
    write /sys/devices/system/cpu/cpu7/cpufreq/schedutil/pl 1
    # Boost set all cores input_boost_freq
	write /sys/module/cpu_boost/parameters/input_boost_freq "0:1036800"
    write /sys/module/cpu_boost/parameters/input_boost_ms 120
   # Thermals
    write /sys/class/thermal/thermal_zone73/cdev0_upper_limit 00
    write /sys/class/thermal/thermal_zone73/cdev1_upper_limit 00
    write /sys/class/kgsl/kgsl-3d0/throttling 0
   # Props
    setprop vendor.display.enable_rotator_ui 1
    # Top App Stune Boost
    write /dev/stune/foreground/schedtune.boost 30
    write /dev/stune/foreground/schedtune.prefer_idle 0
    write /dev/stune/top-app/schedtune.prefer_idle 0
    # Setup runtime cpusets
    write /dev/cpuset/foreground/cpus 0-2,4-7
    # VM
    write /proc/sys/vm/dirty_expire_centisecs 500
    write /proc/sys/vm/dirty_writeback_centisecs 3000
    # MISC
    write /sys/module/sync/parameters/fsync_enabled "N"
