cc_defaults {
    name: "android.hardware.health-service.samurai-defaults",
    relative_install_path: "hw",
    vintf_fragments: ["android.hardware.health-service.samurai.xml"],
    vendor: true,
    recovery_available: true,

    defaults: [
        "libhealth_aidl_impl_user",
    ],

    include_dirs: [
        "system/core/healthd",
        "system/core/healthd/include",
        "system/core/healthd/include_charger",
    ],

    static_libs: [
        "libhealth_aidl_impl",
    ],

    shared_libs: [
        "libcutils",
    ],

    srcs: [
        "main.cpp",
    ],

    cflags: [
        "-Wall",
        "-Werror",
    ],
}

cc_binary {
    name: "android.hardware.health-service.samurai",
    recovery: false,
    vendor: true,
    defaults: ["android.hardware.health-service.samurai-defaults"],
    init_rc: ["android.hardware.health-service.samurai.rc"],
    overrides: ["charger"],
}

cc_binary {
    name: "android.hardware.health-service.samurai_recovery",
    vendor: false,
    recovery: true,
    defaults: ["android.hardware.health-service.samurai-defaults"],
    init_rc: ["android.hardware.health-service.samurai_recovery.rc"],
    overrides: ["charger.recovery"],
}
